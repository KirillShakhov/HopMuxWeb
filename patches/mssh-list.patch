+pub async fn list_directory(config: &Config, target: &str, path: &str) -> Result<()> {
+    let connection = transfer::connect_any(config, target).await?;
+    let sftp = transfer::sftp(&connection).await?;
+    let path = sftp.canonicalize(path).await?;
+    let mut entries = Vec::new();
+    for entry in sftp.read_dir(&path).await? {
+        let name = entry.file_name();
+        if name.is_empty() || name == "." || name == ".." || name.contains('/') {
+            continue;
+        }
+        let metadata = entry.metadata();
+        let directory = metadata.file_type().is_dir();
+        let size = if directory { None } else { metadata.size };
+        entries.push((directory, name, size));
+    }
+    entries.sort_by(|a, b| b.0.cmp(&a.0).then_with(|| a.1.cmp(&b.1)));
+    let entries: Vec<_> = entries.into_iter().map(|(directory, name, size)| {
+        serde_json::json!({ "name": name, "directory": directory, "size": size })
+    }).collect();
+    println!("{}", serde_json::json!({ "path": path, "entries": entries }));
+    Ok(())
+}
+
+pub async fn path_is_directory(config: &Config, target: &str, path: &str) -> Result<bool> {
+    let connection = transfer::connect_any(config, target).await?;
+    let sftp = transfer::sftp(&connection).await?;
+    Ok(sftp.metadata(path).await?.file_type().is_dir())
+}
